  Share2, 
  Download, 
  Copy, 
  ArrowLeft, 
  Instagram, 
  MapPin, 
  Sparkles, 
  Check,
  Heart,
  Camera,
  Compass
} from 'lucide-react';
import Link from 'next/link';

