              <h2 className="text-2xl font-black">{tripSummary.title}</h2>
              <p className="text-xs opacity-90">{tripSummary.vibe}</p>
            </div>

            <div className="bg-black/10 backdrop-blur-md p-4 rounded-2xl text-xs space-y-1">
              <div className="font-bold opacity-80 text-[10px]">ROUTE HIGHLIGHTS</div>
              <div className="font-bold">{tripSummary.spots.join(' → ')}</div>
